{
  "name": "harshmaps",
  "version": "0.1.0",
  "description": "Configurable mapping SDK and experimental worldwide places layer built on open map infrastructure",
  "type": "module",
  "license": "MIT",
  "main": "./sdk/harshmaps.js",
  "types": "./sdk/harshmaps.d.ts",
  "exports": {
    ".": {
      "types": "./sdk/harshmaps.d.ts",
      "import": "./sdk/harshmaps.js"
